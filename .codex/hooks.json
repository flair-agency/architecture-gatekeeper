{
  "description": "Fail-closed local review of the shared Architecture Gatekeeper boundary.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm exec --offline -- architecture-gatekeeper",
            "timeout": 300,
            "statusMessage": "Reviewing the Architecture Gatekeeper boundary",
            "additionalContextLimit": 8000
          }
        ]
      }
    ]
  }
}
