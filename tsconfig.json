{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "skipLibCheck": false,
    "types": ["node"],
    "outDir": "dist-typescript"
  },
  "include": ["src-ts/**/*.mts"]
}
