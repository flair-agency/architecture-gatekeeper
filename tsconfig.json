{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "skipLibCheck": false,
    "types": ["node"],
    "outDir": "dist",
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/**/*.mjs", "src/**/*.mts"]
}
