{
  "name": "@flair-agency/architecture-gatekeeper",
  "version": "0.6.0-preview.2",
  "description": "Reusable local and CI architecture gates for Codex repositories",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "bin": {
    "architecture-gatekeeper": "src/local-gate.mjs",
    "architecture-review": "src/manual-review.mjs",
    "architecture-review-native": "src/native-review.mjs",
    "architecture-review-gemini-ci": "src/gemini-launcher.mjs",
    "architecture-gate-policy": "src/resolve-ci-policy.mjs",
    "architecture-owner-addition-finalize": "src/owner-addition-finalize.mjs"
  },
  "exports": {
    ".": "./src/local-gate.mjs",
    "./review-contract": "./src/review-contract.mjs",
    "./gemini-transport": "./src/gemini-transport.mjs",
    "./gemini-ci-runner": "./src/gemini-ci-runner.mjs",
    "./policy": "./src/resolve-ci-policy.mjs",
    "./owner-addition-adoption": "./src/owner-addition-adoption.mjs",
    "./owner-addition-finalize": "./src/owner-addition-finalize.mjs"
  },
  "files": [
    "src",
    "docs/README.md",
    "docs/architecture.md",
    "docs/development.md",
    "docs/release.md",
    "docs/issue-pr-workflow.md",
    "docs/integration-reference.md",
    "docs/github-assurance.md",
    "docs/owner-intervention.md",
    "docs/reviewer-host-permissions.md",
    "docs/self-gate-actions-policy.md",
    "docs/investigations/2026-09-23-child-reviewer-host-permissions.md",
    "docs/investigations/native-skill-e2e-template.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "codeql": "node scripts/codeql-local.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
