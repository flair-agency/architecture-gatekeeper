{
  "name": "@flair-agency/architecture-gatekeeper",
  "version": "0.4.0",
  "description": "Reusable local and CI architecture gates for Codex repositories",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "bin": {
    "architecture-gatekeeper": "src/local-gate.mjs",
    "architecture-review": "src/manual-review.mjs",
    "architecture-review-native": "src/native-review.mjs",
    "architecture-gate-policy": "src/resolve-ci-policy.mjs"
  },
  "exports": {
    ".": "./src/local-gate.mjs",
    "./review-contract": "./src/review-contract.mjs",
    "./policy": "./src/resolve-ci-policy.mjs"
  },
  "files": ["src", "docs/architecture.md", "docs/owner-intervention.md", "docs/reviewer-host-permissions.md", "docs/self-gate-actions-policy.md", "docs/investigations/2026-09-23-child-reviewer-host-permissions.md", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": { "node": ">=22" }
}
