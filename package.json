{
  "name": "@flair-agency/architecture-gatekeeper",
  "version": "0.3.2",
  "description": "Reusable local and CI architecture gates for Codex repositories",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flair-agency/architecture-gatekeeper.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "bin": {
    "architecture-gatekeeper": "src/local-gate.mjs",
    "architecture-review": "src/manual-review.mjs",
    "architecture-gate-policy": "src/resolve-ci-policy.mjs"
  },
  "exports": {
    ".": "./src/local-gate.mjs",
    "./policy": "./src/resolve-ci-policy.mjs"
  },
  "files": ["src", "docs/architecture.md", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": { "node": ">=22" }
}
